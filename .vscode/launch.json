{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Start SentinelOps Web Dashboard & API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "2. Simulate Linux Crash via Collector Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent/linux_collector.py",
      "args": [
        "--simulate",
        "nginx"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "3. Run Evaluation & Statistical Benchmark",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_system.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
