# Local development template only. Keep real secrets in an untracked .env file
# or in your deployment's secret manager.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=sqlite:///./sentinelops.db
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SENTINELOPS_API_KEY=
SLACK_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=

# Linux collector settings; configure these in the agent's protected env file.
SENTINELOPS_URL=
SENTINELOPS_REDACT_LOCAL=false

# Live SSH remediation is intentionally disabled unless explicitly configured.
SSH_REMEDIATION_ENABLED=false
SSH_ALLOWED_HOSTS=
SSH_ALLOWED_COMMANDS=[]
SSH_ALLOWED_DIAGNOSTIC_COMMANDS=[]
SSH_ALLOWED_POSTCHECK_COMMANDS=[]
SSH_KNOWN_HOSTS=
TARGET_SSH_USER=
TARGET_SSH_KEY_PATH=

# Docker Compose demo database only.
POSTGRES_PASSWORD=

# Agent proactive alert thresholds. CPU utilization is sampled from /proc/stat.
SENTINELOPS_CPU_THRESHOLD_PCT=90
SENTINELOPS_MEMORY_THRESHOLD_PCT=90
SENTINELOPS_DISK_THRESHOLD_PCT=90
SENTINELOPS_THRESHOLD_CLEAR_MARGIN_PCT=5
SENTINELOPS_THRESHOLD_COOLDOWN_SECONDS=300
