# Local development template only. Keep real secrets in an untracked .env file
# or in your deployment's secret manager.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=sqlite:///./sentinelops.db
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SENTINELOPS_API_KEY=
SLACK_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=

# Linux collector settings; configure these in the agent's protected env file.
SENTINELOPS_URL=

# Live SSH remediation is intentionally disabled unless explicitly configured.
SSH_REMEDIATION_ENABLED=false
SSH_ALLOWED_HOSTS=
SSH_ALLOWED_COMMANDS=[]
SSH_KNOWN_HOSTS=
TARGET_SSH_USER=
TARGET_SSH_KEY_PATH=
