[Unit]
Description=SentinelOps Automated Linux Diagnostic Log Collector Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinelops
Group=sentinelops
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/sentinelops/collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/sentinelops/linux_collector.py --daemon --interval 30
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
